/*
 * MutaXplorer - configuration
 * Every parameter can be set on the command line (--name value) or in a -params-file (YAML/JSON).
 * Parameters left as null get an assay-specific default (see "assay presets" below).
 */

manifest {
    name            = 'mutaxplorer'
    description     = 'SNV/indel, CNV, SV, fusion, TMB, MSI and signature analysis for WGS, WES and panels (FASTQ or BAM, hg19 or hg38)'
    version         = '1.0.0'
    nextflowVersion = '>=24.04.0'
    mainScript      = 'main.nf'
    homePage        = 'https://github.com/deppworld/mutaxplorer'
}

params {
    // ---- input / output
    input               = null          // samplesheet CSV: patient,sample,status,fastq_1,fastq_2,bam
    outdir              = 'results'

    // ---- study design
    genome              = 'hg38'        // hg19 | hg38
    assay               = 'panel'       // wgs | wes | panel
    analysis            = 'somatic'     // somatic | germline | both
    germline_samples    = 'normal'      // with --analysis both: 'normal' samples only, or 'all'
    tools               = 'snv,cnv,sv,fusion,msi,signatures,identity'   // drop any you do not need

    // ---- reference & resources (set resource_dir to use scripts/setup_resources.sh layout)
    resource_dir        = null
    fasta               = null
    bwa_index           = null          // folder with bwa-mem2 index of <fasta name>; built if absent and FASTQ given
    targets             = null          // BED (required for wes / panel)
    exclude_bed         = null          // WGS: regions to skip (e.g. ENCODE blacklist)
    interval_padding    = 25
    germline_resource   = null          // gnomAD af-only VCF (+ .tbi)
    common_sites        = null          // small_exac_common_3 VCF for contamination
    pon                 = null          // Mutect2 panel of normals
    known_sites         = null          // comma-separated VCFs for BQSR (dbSNP, Mills); BQSR runs only if set
    msisensor2_models   = null          // MSIsensor2 models folder (models_hg38 / models_hg19_GRCh37)
    vep_cache           = null          // Ensembl VEP cache folder; annotation skipped if null
    vep_assembly        = null          // GRCh38 / GRCh37 (auto from genome)
    gtf                 = null          // GENCODE/Ensembl GTF: gene-level CNV, SV/fusion annotation, RNA fusions
    star_index          = null          // STAR index for RNA fusions (built from fasta + gtf if absent)
    rna_read_length     = 150
    arriba_blacklist    = null          // default: Arriba's bundled list for the genome; 'none' to disable
    arriba_known_fusions = null         // default: Arriba's bundled list
    arriba_protein_domains = null       // default: Arriba's bundled file
    known_fusions       = null          // gene1<TAB>gene2 list used to flag DNA/RNA fusions (e.g. Arriba's)
    signatures          = null          // COSMIC-style SBS96 signature matrix (Type column + one column per signature)
    signature_min_snvs  = 50            // fit signatures only for samples with at least this many SNVs

    // ---- read processing
    min_read_length     = 36
    fastp_args          = ''
    umi                 = false         // UMI consensus with fgbio
    umi_loc             = null          // fastp UMI location (e.g. per_read, read1); null = UMI already in read name
    umi_len             = 0
    umi_skip            = 0
    umi_strategy        = 'adjacency'
    umi_min_reads       = 1

    // ---- calling
    scatter_count       = null          // interval chunks (auto: wgs 24, wes 8, panel 2)
    max_reads_per_start = null          // Mutect2 downsampling (auto: panel 0 = off, otherwise 50)
    mutect2_args        = ''
    filter_mutect_args  = ''
    haplotypecaller_args = ''
    vep_args            = ''

    // ---- coverage / reporting (null = assay preset)
    coverage_thresholds = null          // mosdepth thresholds; the first is used for TMB denominator
    min_dp              = null
    min_alt_reads       = null
    min_vaf             = 0.05          // somatic reportable VAF
    germline_min_vaf    = 0.20          // germline reportable VAF (heterozygous)
    max_pop_af          = 0.01          // gnomAD AF ceiling (somatic: germline removal; germline: rare variants)
    tmb_region_mb       = null          // fixed TMB denominator (auto: wgs 35 Mb coding; otherwise covered target)
    msi_min_coverage    = null
    msi_high_cutoff     = 20
    cnv_method          = null          // CNVkit: auto = wgs for WGS, hybrid for WES/panel ('amplicon' for amplicon panels)
    cnv_amp_cn          = 4             // gene called amplified at >= this copy number
    purity              = null          // tumour purity for CNVkit copy-number rescaling (0-1)
    sv_min_support      = 4             // min Manta alt reads (PR+SR) for a DNA fusion call
    msi_min_sites       = 20
    top_n_genes         = 30
    top_n_variants      = 25

    // ---- resources per genome (relative to resource_dir; written by scripts/setup_resources.sh)
    genomes = [
        hg38: [
            fasta             : 'hg38/Homo_sapiens_assembly38.fasta',
            germline_resource : 'hg38/af-only-gnomad.hg38.vcf.gz',
            common_sites      : 'hg38/small_exac_common_3.hg38.vcf.gz',
            pon               : 'hg38/1000g_pon.hg38.vcf.gz',
            known_sites       : 'hg38/Homo_sapiens_assembly38.dbsnp138.vcf.gz,hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz',
            msisensor2_models : 'msisensor2/models_hg38',
            vep_cache         : 'vep_cache',
            vep_assembly      : 'GRCh38',
            gtf               : 'hg38/gencode.annotation.gtf.gz',
            known_fusions     : 'hg38/known_fusions.tsv.gz'
        ],
        hg19: [
            fasta             : 'hg19/hg19.fa',
            germline_resource : 'hg19/af-only-gnomad.hg19.vcf.gz',
            common_sites      : 'hg19/small_exac_common_3.hg19.vcf.gz',
            pon               : 'hg19/Mutect2-exome-panel.hg19.vcf.gz',
            known_sites       : null,
            msisensor2_models : 'msisensor2/models_hg19_GRCh37',
            vep_cache         : 'vep_cache',
            vep_assembly      : 'GRCh37',
            gtf               : 'hg19/gencode.annotation.gtf.gz',
            known_fusions     : 'hg19/known_fusions.tsv.gz'
        ]
    ]
}

// ---- assay presets: fill only what the user did not set (genome resources are resolved in main.nf)
params.vep_assembly        = params.vep_assembly        ?: (params.genome == 'hg19' ? 'GRCh37' : 'GRCh38')
params.scatter_count       = params.scatter_count       ?: [wgs: 24, wes: 8, panel: 2][params.assay] ?: 4
params.max_reads_per_start = params.max_reads_per_start != null ? params.max_reads_per_start : (params.assay == 'panel' ? 0 : 50)
params.coverage_thresholds = params.coverage_thresholds ?: [wgs: '10,20,30', wes: '20,50,100', panel: '100,250,500'][params.assay] ?: '20,50,100'
params.min_dp              = params.min_dp              ?: [wgs: 10, wes: 20, panel: 100][params.assay] ?: 20
params.min_alt_reads       = params.min_alt_reads       ?: [wgs: 3, wes: 4, panel: 5][params.assay] ?: 4
params.msi_min_coverage    = params.msi_min_coverage    ?: (params.assay == 'wgs' ? 15 : 20)
params.tmb_region_mb       = params.tmb_region_mb       ?: (params.assay == 'wgs' ? 35 : null)
params.cnv_method          = params.cnv_method          ?: (params.assay == 'wgs' ? 'wgs' : 'hybrid')

includeConfig 'conf/base.config'

profiles {
    standard    { process.executor = 'local' }
    conda       { conda.enabled = true;  includeConfig 'conf/conda.config' }
    mamba       { conda.enabled = true;  conda.useMamba = true; includeConfig 'conf/conda.config' }
    docker      { docker.enabled = true; docker.runOptions = '-u $(id -u):$(id -g)'; includeConfig 'conf/containers.config' }
    singularity { singularity.enabled = true; singularity.autoMounts = true; includeConfig 'conf/containers.config' }
    apptainer   { apptainer.enabled = true; apptainer.autoMounts = true; includeConfig 'conf/containers.config' }
    slurm       { process.executor = 'slurm' }
    test        { includeConfig 'conf/test.config' }
}

process.publishDir = [path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" }, mode: 'copy', enabled: false]
includeConfig 'conf/publish.config'

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv"; overwrite = true }
