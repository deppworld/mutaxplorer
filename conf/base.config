// MutaXplorer - default resources per process label (scale with retries)
process {
    cpus   = { 1 }
    memory = { 4.GB * task.attempt }
    time   = { 4.h * task.attempt }
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries = 2

    withLabel: process_single      { cpus = { 1 };  memory = { 4.GB * task.attempt };  time = { 4.h * task.attempt } }
    withLabel: process_low         { cpus = { 2 };  memory = { 8.GB * task.attempt };  time = { 6.h * task.attempt } }
    withLabel: process_medium      { cpus = { 4 };  memory = { 16.GB * task.attempt }; time = { 12.h * task.attempt } }
    withLabel: process_high        { cpus = { 12 }; memory = { 32.GB * task.attempt }; time = { 24.h * task.attempt } }
    withLabel: process_high_memory { cpus = { 8 };  memory = { 72.GB * task.attempt }; time = { 24.h * task.attempt } }
}

// cap requests to what the machine / queue offers:  --max_cpus 16 --max_memory 64.GB
params.max_cpus   = 16
params.max_memory = 64.GB
process {
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory]
}
