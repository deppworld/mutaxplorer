// MutaXplorer - containers. Build once:  bash docker/build_images.sh   (or push to your registry and set params.container_registry)
params.container_registry = ''
params.container_tag      = '1.0.0'
params.vep_container      = 'ensemblorg/ensembl-vep:release_113.0'
process {
    container = "${params.container_registry}mutaxplorer:${params.container_tag}"
    withLabel: vep    { container = params.vep_container }
    withLabel: cnvkit { container = "${params.container_registry}mutaxplorer-cnvkit:${params.container_tag}" }
    withLabel: manta  { container = "${params.container_registry}mutaxplorer-manta:${params.container_tag}" }
    withLabel: arriba { container = "${params.container_registry}mutaxplorer-arriba:${params.container_tag}" }
}
