// MutaXplorer - conda / mamba environments
process {
    conda = "${projectDir}/envs/mutaxplorer.yml"
    withLabel: vep    { conda = "${projectDir}/envs/vep.yml" }
    withLabel: cnvkit { conda = "${projectDir}/envs/cnvkit.yml" }
    withLabel: manta  { conda = "${projectDir}/envs/manta.yml" }
    withLabel: arriba { conda = "${projectDir}/envs/arriba.yml" }
}
