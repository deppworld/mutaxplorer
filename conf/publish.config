// MutaXplorer - what is published to --outdir
process {
    withName: 'FASTP'            { publishDir = [path: { "${params.outdir}/preprocessing/fastp" }, mode: 'copy', pattern: '*.{json,html}'] }
    withName: 'MARK_DUPLICATES|UMI_CONSENSUS|BQSR|PREPARE_BAM' {
        publishDir = [path: { "${params.outdir}/preprocessing/bam" }, mode: 'copy',
                      pattern: '*.{bam,bai,txt,table}', enabled: params.save_bam]
    }
    withName: 'MOSDEPTH'         { publishDir = [path: { "${params.outdir}/qc/coverage" }, mode: 'copy'] }
    withName: 'SAMTOOLS_STATS'   { publishDir = [path: { "${params.outdir}/qc/samtools" }, mode: 'copy'] }
    withName: 'MULTIQC'          { publishDir = [path: { "${params.outdir}/multiqc" }, mode: 'copy'] }
    withName: 'FILTER_MUTECT'    { publishDir = [path: { "${params.outdir}/somatic/vcf" }, mode: 'copy'] }
    withName: 'MSISENSOR2'       { publishDir = [path: { "${params.outdir}/somatic/msi" }, mode: 'copy'] }
    withName: 'GERMLINE_FILTER'  { publishDir = [path: { "${params.outdir}/germline/vcf" }, mode: 'copy'] }
    withName: 'NORMALIZE_SOM|VEP_SOM'   { publishDir = [path: { "${params.outdir}/somatic/vcf" }, mode: 'copy'] }
    withName: 'NORMALIZE_GERM|VEP_GERM' { publishDir = [path: { "${params.outdir}/germline/vcf" }, mode: 'copy'] }
    withName: 'REPORT_SOM|REPORT_GERM'  { publishDir = [path: { "${params.outdir}" }, mode: 'copy'] }
    withName: 'CNV_CALL_SOM'     { publishDir = [path: { "${params.outdir}/somatic/cnv" }, mode: 'copy'] }
    withName: 'CNV_CALL_GERM'    { publishDir = [path: { "${params.outdir}/germline/cnv" }, mode: 'copy'] }
    withName: 'CNV_REF_SOM|CNV_REF_GERM' { publishDir = [path: { "${params.outdir}/reference/cnvkit" }, mode: 'copy'] }
    withName: 'MANTA_SOM'        { publishDir = [path: { "${params.outdir}/somatic/sv" }, mode: 'copy'] }
    withName: 'MANTA_GERM'       { publishDir = [path: { "${params.outdir}/germline/sv" }, mode: 'copy'] }
    withName: 'ARRIBA'           { publishDir = [path: { "${params.outdir}/rna/fusions" }, mode: 'copy'] }
    withName: 'IDENTITY'         { publishDir = [path: { "${params.outdir}/qc/identity" }, mode: 'copy'] }
    withName: 'GENE_BED'         { publishDir = [path: { "${params.outdir}/reference" }, mode: 'copy'] }
}
params.save_bam = true
