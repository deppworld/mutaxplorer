// MutaXplorer - built-in example on simulated data (all modules).
// First:  python3 tests/simulate_test_data.py tests/data      (needs wgsim, bwa-mem2, samtools, bcftools)
// Annotation without the VEP cache:  export PATH=$PWD/tests/bin:$PATH MUTAXPLORER_MOCK_GNOMAD=$PWD/tests/data/gnomad.vcf.gz
params {
    input             = "${projectDir}/tests/data/samplesheet.csv"
    fasta             = "${projectDir}/tests/data/genome.fa"
    bwa_index         = "${projectDir}/tests/data/bwamem2"
    targets           = "${projectDir}/tests/data/targets.bed"
    gtf               = "${projectDir}/tests/data/genes.gtf.gz"
    germline_resource = "${projectDir}/tests/data/gnomad.vcf.gz"
    common_sites      = "${projectDir}/tests/data/common.vcf.gz"
    known_fusions     = "${projectDir}/tests/data/known_fusions.tsv"
    signatures        = "${projectDir}/tests/data/toy_signatures.tsv"
    vep_cache         = "${projectDir}/tests/data/vep_cache"
    signature_min_snvs = 3
    arriba_blacklist  = 'none'
    genome            = 'hg38'
    assay             = 'panel'
    analysis          = 'both'
    max_cpus          = 4
    max_memory        = 4.GB
}
process {
    withLabel: 'process_medium|process_high|process_high_memory' { cpus = 2; memory = 4.GB }
    withLabel: 'process_low|process_single' { cpus = 1; memory = 3.GB }
}
